# Supabase publico usado no navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase privado. Nunca expor a service role key no navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# URLs publicas da aplicacao.
NEXT_PUBLIC_SITE_URL=https://www.nexawi.com.br
NEXT_PUBLIC_APP_URL=https://www.nexawi.com.br

# URL publica usada pelo MikroTik para teste de banda controlado.
# Em producao, deixe apontando para a URL publica onde esta app responde.
NEXAWI_SPEEDTEST_DOWNLOAD_URL=https://www.nexawi.com.br/api/speedtest/download?bytes=1000000000

# Control API / VPS.
CONTROL_API_MODE=proxy
CONTROL_API_BASE_URL=
NEXAWI_CONTROL_SECRET=
NEXAWI_CRON_SECRET=
NEXAWI_CONTROL_API_SOURCE=control-api

# Politica de sessao do portal.
NEXAWI_SESSION_MINUTES=60
NEXAWI_COOLDOWN_MINUTES=20
NEXAWI_OFFLINE_IDLE_SECONDS=120

# RouterOS / MikroTik.
ROUTEROS_BASE_URL=http://10.70.0.2
ROUTEROS_USERNAME=
ROUTEROS_PASSWORD=
ROUTEROS_HOTSPOT_SERVER=
NEXAWI_HOTSPOT_SUBNET=192.168.88.0/24
NEXAWI_CLIENT_RATE_DOWNLOAD=5M
NEXAWI_CLIENT_RATE_UPLOAD=2M

# WireGuard / acesso remoto do MikroTik.
# 10.70.0.2 e um IP privado da VPN, nao um IP publico.
NEXAWI_ROUTER_VPN_ADDRESS=10.70.0.2/24
NEXAWI_VPN_SERVER_ADDRESS=10.70.0.1/32
NEXAWI_VPN_ENDPOINT=207.244.230.147

# E-mail transacional.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_ALERT_EMAIL=contato@nexawi.com.br

# Rota legada /api/Contato.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=contato@nexawi.com.br

# Asaas / cobranca recorrente SaaS.
ASAAS_ENV=sandbox
# Em arquivo .env local/VPS, escape o $ inicial: ASAAS_API_KEY=\$aact_hmlg_...
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_BASE_URL=
ASAAS_FINE_PERCENT=3
ASAAS_INTEREST_PERCENT=2

# RADIUS, se usado.
RADIUS_PORT=1812
RADIUS_SECRET=
